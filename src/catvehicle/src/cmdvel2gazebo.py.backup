# This node converts cmd_vel inputs to the vehicle to the ROS topics that
# are exposed in Gazebo for moving the vehicle in simulation. Notably, the
# inputs to Gazebo are to joints on the wheel, so there is a multiplier of
# 2.8101 that is applied to the joint's velocity whenever we try to move
# so that the output in Gazebo will match the desired input velocity.

import rclpy
from rclpy.node import Node

from std_msgs.msg import Float64
from geometry_msgs.msg import Twist

import sys
import getopt
import math


class CmdVel2Gazebo(Node):

    def __init__(self, ns):
        super().__init__('cmdvel2gazebo')

        self.ns = ns

        # Subscribe to cmd_vel
        self.cmd_vel_sub = self.create_subscription(
            Twist,
            'cmd_vel',
            self.callback,
            10
        )

        # Steering publishers
        self.pub_steerL = self.create_publisher(
            Float64,
            'front_left_steering_position_controller/command',
            1
        )

        self.pub_steerR = self.create_publisher(
            Float64,
            'front_right_steering_position_controller/command',
            1
        )

        # Rear wheel velocity publishers
        self.pub_rearL = self.create_publisher(
            Float64,
            'joint1_velocity_controller/command',
            1
        )

        self.pub_rearR = self.create_publisher(
            Float64,
            'joint2_velocity_controller/command',
            1
        )

        # Initial velocity and tire angle are 0
        self.x = 0.0
        self.z = 0.0

        # Car wheelbase (m)
        self.L = 2.62

        # Car tread (m)
        self.T = 1.29

        # Dead man's switch timeout
        self.timeout = 0.2

        self.lastMsg = self.get_clock().now()

        # Maximum inside tire steering angle
        self.maxsteerInside = 0.6

        # tan(maxsteerInside) = wheelbase/radius
        rMax = self.L / math.tan(self.maxsteerInside)

        # Radius of ideal middle tire
        rIdeal = rMax + (self.T / 2.0)

        # tan(angle) = wheelbase/radius
        self.maxsteer = math.atan2(self.L, rIdeal)

        self.get_logger().info(
            "Maximum ideal steering angle set to {0}.".format(
                self.maxsteer
            )
        )

        # 100 Hz publishing timer
        self.timer = self.create_timer(
            0.01,
            self.publish
        )

    def callback(self, data):

        # 2.6101 is the gain factor accounting for
        # mechanical reduction of the tyres
        self.x = 2.6101 * data.linear.x

        # Constrain ideal steering angle
        self.z = max(
            -self.maxsteer,
            min(self.maxsteer, data.angular.z)
        )

        self.lastMsg = self.get_clock().now()

    def publish(self):

        # Check timeout
        current_time = self.get_clock().now()

        elapsed = (
            current_time - self.lastMsg
        ).nanoseconds / 1e9

        if elapsed > self.timeout:

            # Set velocity to zero after timeout
            self.x = 0.0
            return

        if self.z != 0:

            T = self.T
            L = self.L

            # self.x is linear velocity
            r = L / math.fabs(math.tan(self.z))

            rL = r - (
                math.copysign(1, self.z) * (T / 2.0)
            )

            rR = r + (
                math.copysign(1, self.z) * (T / 2.0)
            )

            msgRearR = Float64()

            # Right tire goes faster when turning left
            msgRearR.data = self.x * rR / r

            msgRearL = Float64()

            # Left tire goes slower when turning left
            msgRearL.data = self.x * rL / r

            self.pub_rearL.publish(msgRearL)
            self.pub_rearR.publish(msgRearR)

            msgSteerL = Float64()
            msgSteerR = Float64()

            # Left tire angle
            msgSteerL.data = (
                math.atan2(L, rL)
                * math.copysign(1, self.z)
            )

            self.pub_steerL.publish(msgSteerL)

            # Right tire angle
            msgSteerR.data = (
                math.atan2(L, rR)
                * math.copysign(1, self.z)
            )

            self.pub_steerR.publish(msgSteerR)

        else:

            # Straight driving
            msgRear = Float64()
            msgRear.data = self.x

            self.pub_rearL.publish(msgRear)
            self.pub_rearR.publish(msgRear)

            msgSteer = Float64()
            msgSteer.data = self.z

            self.pub_steerL.publish(msgSteer)
            self.pub_steerR.publish(msgSteer)


def usage():
    print('cmdvel2gazebo -n catvehicle')


def main(argv):

    # Namespace
    ns = ''

    try:
        opts, args = getopt.getopt(
            argv,
            "hn:",
            ["help", "namespace="]
        )
    except getopt.GetoptError:
        usage()
        return

    for opt, arg in opts:

        if opt in ("-h", "--help"):
            usage()
            return

        elif opt in ("-n", "--namespace"):
            ns = arg

        else:
            usage()
            return

    rclpy.init(args=None)

    node = CmdVel2Gazebo(ns)

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main(sys.argv[1:])