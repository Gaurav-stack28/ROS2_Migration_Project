<?xml version="1.0"?>
<package format="3">

  <name>sicktoolbox_wrapper</name>
  <version>2.5.3</version>

  <description>
    sicktoolbox_wrapper is a ROS2 wrapper for the SICK LMS2xx lasers.
  </description>

  <maintainer email="chadrockey@gmail.com">
    Chad Rockey
  </maintainer>

  <license>BSD</license>

  <url type="website">
    http://ros.org/wiki/sicktoolbox_wrapper
  </url>

  <url type="bugtracker">
    https://github.com/ros-drivers/sicktoolbox_wrapper/issues
  </url>

  <url type="repository">
    https://github.com/ros-drivers/sicktoolbox_wrapper
  </url>

  <author email="mquigley@cs.stanford.edu">
    Morgan Quigley
  </author>


  <!-- ROS2 build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>


  <!-- ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_updater</depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>