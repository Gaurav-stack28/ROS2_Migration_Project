  <version>2.0.0</version>

  <description>
    This package is generated from obstacleStopper Simulink model.
    Migrated from ROS1 to ROS2 Foxy.
  </description>


  <maintainer email="rahulbhadani@email.arizona.edu">
    Rahul Bhadani
  </maintainer>


  <license>BSD</license>


