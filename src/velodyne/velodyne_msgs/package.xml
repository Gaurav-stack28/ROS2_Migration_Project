  <maintainer email="josh.whitley@autoware.org">
    Josh Whitley
  </maintainer>

  <author>Jack O'Quin</author>

  <license>BSD</license>

  <url type="website">
    http://ros.org/wiki/velodyne_msgs
  </url>

  <url type="repository">
    https://github.com/ros-drivers/velodyne
  </url>

